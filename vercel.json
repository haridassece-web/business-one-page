{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/3d-hub/:match*",
      "destination": "/3d-hub/:match*"
    },
    {
      "source": "/nexus-creative-3d/:match*",
      "destination": "/nexus-creative-3d/:match*"
    },
    {
      "source": "/assets/:match*",
      "destination": "/assets/:match*"
    },
    {
      "source": "/((?!3d-hub|nexus-creative-3d|assets).*)",
      "destination": "/index.html"
    }
  ]
}
